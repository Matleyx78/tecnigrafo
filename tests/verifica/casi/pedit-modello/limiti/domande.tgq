; Casi limite dell'unione con distanza (ADR 0050, PT32).

; fuzz=0 conserva la regola di join per estremi coincidenti.
S0 = LWPOLYLINE vertex=0,0 vertex=1,0
L0 = LINE start=1,0 end=2,0
? pedit-join S0 L0 fuzz=0 type=extend -> S0 LWPOLYLINE closed=no vertex=0,0 vertex=1,0 vertex=2,0 added=1 consumed=L0

; La tolleranza delle unita riconosce la coincidenza anche se fuzz e minore.
ST = LWPOLYLINE vertex=0,0 vertex=1,0
LT = LINE start=1.0000000001,0 end=2,0
? pedit-join ST LT fuzz=0 units=4 type=extend -> ST LWPOLYLINE closed=no vertex=0,0 vertex=1,0 vertex=2,0 added=1 consumed=LT

; Raggiunto di nuovo il primo estremo, la polilinea si chiude e si ferma.
C = LWPOLYLINE vertex=0,0 vertex=1,0 vertex=1,1
CP = LWPOLYLINE vertex=1,1 vertex=0,1 vertex=0,0
EXTRA = LINE start=0,0 end=-1,0
? pedit-join C CP EXTRA fuzz=0 type=extend -> C LWPOLYLINE closed=yes vertex=0,0 vertex=1,0 vertex=1,1 vertex=0,1 added=2 consumed=CP

; Polilinee chiuse e polilinee a quota diversa sono ignorate.
BASE = LWPOLYLINE vertex=0,0 vertex=1,0
CLOSED = LWPOLYLINE closed=yes vertex=1,0 vertex=2,0 vertex=2,1
HIGH = LWPOLYLINE vertex=1,0 vertex=2,0 elevation=1
? pedit-join BASE CLOSED HIGH fuzz=2 type=add -> none

; Prolungare una linea conserva la larghezza del suo estremo.
W = LWPOLYLINE vertex=0,0 start-width=1 end-width=3 vertex=1,0
WV = LINE start=2,1 end=2,3
? pedit-join W WV fuzz=2 type=extend -> W LWPOLYLINE closed=no vertex=0,0 start-width=1 end-width=3 vertex=2,0 vertex=2,3 added=1 consumed=WV
