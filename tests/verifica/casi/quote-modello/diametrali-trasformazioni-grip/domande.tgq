;
; RT24 / PT24 (#709), ADR 0047 and PT23/PT24 as updated by PR #836.
; Expectations come from independent arithmetic or stored AutoCAD blocks.
; No Tecnigrafo executable was used to derive these values.

; Independent affine arithmetic; text Angle=30 then ROTATE 90 gives 120.
; Text grips move only text, definition grips regenerate; an invalid edit
; is rejected without changing the entity. The source is queried again after edits.

A = DIMENSION kind=diameter style="ISO-25" point1=30,40 point2=-30,-40 text-point=90,120 measurement=0 text=" " text-rotation=30 user-text-position=yes overrides=DIMCEN:0
? grips A -> -30,-40; 30,40; 90,120
? transform A move 5,7 -> DIMENSION kind=diameter style="ISO-25" point1=35,47 point2=-25,-33 text-point=95,127 measurement=100 text=" " text-rotation=30 user-text-position=yes overrides=DIMCEN:0
? transform A rotate 90 0,0 -> DIMENSION kind=diameter style="ISO-25" point1=-40,30 point2=40,-30 text-point=-120,90 measurement=100 text=" " text-rotation=120 user-text-position=yes overrides=DIMCEN:0
? transform A scale 2 0,0 -> DIMENSION kind=diameter style="ISO-25" point1=60,80 point2=-60,-80 text-point=180,240 measurement=200 text=" " text-rotation=30 user-text-position=yes overrides=DIMCEN:0
? grip A 30,40 60,80 -> DIMENSION kind=diameter style="ISO-25" point1=60,80 point2=-30,-40 text-point=90,120 measurement=150 text=" " text-rotation=30 user-text-position=yes overrides=DIMCEN:0
? grip A 90,120 100,120 -> DIMENSION kind=diameter style="ISO-25" point1=30,40 point2=-30,-40 text-point=100,120 measurement=100 text=" " text-rotation=30 user-text-position=yes overrides=DIMCEN:0
? grip A -30,-40 30,40 -> invalid
? grip A 123,456 0,0 -> none
? grips A -> -30,-40; 30,40; 90,120
? grip A -30,-40 -60,-80 -> DIMENSION kind=diameter style="ISO-25" point1=30,40 point2=-60,-80 text-point=90,120 measurement=150 text=" " text-rotation=30 user-text-position=yes overrides=DIMCEN:0
M = DIMENSION kind=diameter style="ISO-25" point1=30,40 point2=-30,-40 text-point=90,120 measurement=0 text=" " user-text-position=yes overrides=DIMCEN:0
? transform M mirror 0,0 1,0 -> DIMENSION kind=diameter style="ISO-25" point1=30,-40 point2=-30,40 text-point=90,-120 measurement=100 text=" " user-text-position=yes overrides=DIMCEN:0
? transform A scale 0 0,0 -> invalid
? transform A scale -1 0,0 -> invalid
? transform A mirror 1,1 1,1 -> invalid
