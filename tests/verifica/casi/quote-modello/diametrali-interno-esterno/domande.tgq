;
; RT24 / PT24 (#709), ADR 0047 and PT23/PT24 as updated by PR #836.
; Expectations come from independent arithmetic or stored AutoCAD blocks.
; No Tecnigrafo executable was used to derive these values.

; Interior diameter: both arrows point outward. Exterior: the nearer endpoint.
; Equidistant text at (0,6) chooses point1, the DXF point15, not point2.

Inside = DIMENSION kind=diameter style="ISO-25" point1=50,0 point2=-50,0 text-point=0,2 measurement=0 text=" " user-text-position=yes overrides=DIMCEN:0
? distance Inside 48.75,0.05 -> 0
? distance Inside -48.75,0.05 -> 0
Right = DIMENSION kind=diameter style="ISO-25" point1=50,0 point2=-50,0 text-point=80,0 measurement=0 text=" " user-text-position=yes overrides=DIMCEN:0
? distance Right 51.25,0.05 -> 0
Left = DIMENSION kind=diameter style="ISO-25" point1=50,0 point2=-50,0 text-point=-80,0 measurement=0 text=" " user-text-position=yes overrides=DIMCEN:0
? distance Left -51.25,0.05 -> 0
Tie = DIMENSION kind=diameter style="ISO-25" point1=5,0 point2=-5,0 text-point=0,6 measurement=0 text=" " user-text-position=yes overrides=DIMCEN:0
; The leader goes from (5,0) to (0,6), hence passes through (2.5,3).
? distance Tie 2.5,3 -> 0
? crosses Tie -2.6,2.9 -2.4,3.1 -> no
? grip Inside 50,0 -50,0 -> invalid
