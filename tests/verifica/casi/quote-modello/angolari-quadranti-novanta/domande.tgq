; RT24 / PT24 (#709), ADR 0047 and PT23/PT24 as updated by PR #836.
; Expectations come from independent arithmetic or stored AutoCAD blocks.
; No Tecnigrafo executable was used to derive these values.

; Selected sectors are [0,90), [90,180), [180,270), [270,360) for orthogonal lines.
; For the 30-degree line they are [0,30), [30,180), [180,210), [210,360).
; R=10; generated ARC angles are degrees. Stored group 42 uses radians (ADR 0004/DXF).

Q1 = DIMENSION kind=angular style="ISO-25" line-point=0,-100 first=-100,0;100,0 second=0,-100;0,100 arc-point=6,8 text-point=100,100 measurement=0 text=" " user-text-position=yes overrides=DIMASZ:0,DIMCEN:0
? generated Q1 -> ARC center=0,0 radius=10 start-angle=0 end-angle=90
? transform Q1 move 1,2 -> DIMENSION kind=angular style="ISO-25" line-point=1,-98 first=-99,2;101,2 second=1,-98;1,102 arc-point=7,10 text-point=101,102 measurement=1.570796326794897 text=" " user-text-position=yes overrides=DIMASZ:0,DIMCEN:0

Q2 = DIMENSION kind=angular style="ISO-25" line-point=0,-100 first=-100,0;100,0 second=0,-100;0,100 arc-point=-6,8 text-point=100,100 measurement=0 text=" " user-text-position=yes overrides=DIMASZ:0,DIMCEN:0
? generated Q2 -> ARC center=0,0 radius=10 start-angle=90 end-angle=180
? transform Q2 move 1,2 -> DIMENSION kind=angular style="ISO-25" line-point=1,-98 first=-99,2;101,2 second=1,-98;1,102 arc-point=-5,10 text-point=101,102 measurement=1.570796326794897 text=" " user-text-position=yes overrides=DIMASZ:0,DIMCEN:0

Q3 = DIMENSION kind=angular style="ISO-25" line-point=0,-100 first=-100,0;100,0 second=0,-100;0,100 arc-point=-6,-8 text-point=100,100 measurement=0 text=" " user-text-position=yes overrides=DIMASZ:0,DIMCEN:0
? generated Q3 -> ARC center=0,0 radius=10 start-angle=180 end-angle=270
? transform Q3 move 1,2 -> DIMENSION kind=angular style="ISO-25" line-point=1,-98 first=-99,2;101,2 second=1,-98;1,102 arc-point=-5,-6 text-point=101,102 measurement=1.570796326794897 text=" " user-text-position=yes overrides=DIMASZ:0,DIMCEN:0

Q4 = DIMENSION kind=angular style="ISO-25" line-point=0,-100 first=-100,0;100,0 second=0,-100;0,100 arc-point=6,-8 text-point=100,100 measurement=0 text=" " user-text-position=yes overrides=DIMASZ:0,DIMCEN:0
? generated Q4 -> ARC center=0,0 radius=10 start-angle=270 end-angle=0
? transform Q4 move 1,2 -> DIMENSION kind=angular style="ISO-25" line-point=1,-98 first=-99,2;101,2 second=1,-98;1,102 arc-point=7,-6 text-point=101,102 measurement=1.570796326794897 text=" " user-text-position=yes overrides=DIMASZ:0,DIMCEN:0
