;
; RT8 / PT8 (#953): decoration TextLine objects participate in distance and
; selection but never provide snaps, including through a block.

!block "TARGA" base=0,0
T = MTEXT insertion=0,10 height=2.5 width=0 attachment=top-left rotation=0 style="Standard" value="{\\LA}"
L = LINE start=0,0 end=40,0
!endblock
I = INSERT block="TARGA" insertion=0,0 scale=1,1 rotation=0
; cambia con #953
? snap 0.1,7 aperture=0.5 modes=endpoint,midpoint,intersection,nea -> none
? snap 0.1,0.1 aperture=0.5 modes=endpoint,midpoint,intersection,nea -> Endpoint 0,0
? snap 0.1,7 aperture=0.5 modes=insertion -> Insertion 0,7.5
? distance I 1,7 -> 0
? crossing 0.9,6.9 1.1,7.1 -> I

M = MTEXT insertion=0,30 height=2.5 width=0 attachment=top-left rotation=0 style="Standard" value="{\\LA} {\\fArial|b1|i0|c0|p34;A}"
? snap 0.1,27.5 aperture=0.5 modes=insertion -> Insertion 0,30
? snap 0.1,27 aperture=0.5 modes=endpoint,midpoint,intersection,nea -> none
