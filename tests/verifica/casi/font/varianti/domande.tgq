; Liberation Sans 2.1.5 (resources/fonts), read with fontTools.
; Divide hhea.ascent, hhea.descent and hmtx advances by each font's
; OS/2.sCapHeight (1409 in all four files). Sum advances without kerning.
; U+2603 (☃) is absent and uses .notdef. U+2300 (⌀) is absent and uses
; U+00D8 (Ø) under ADR 0013. U+010F (ď) has a distinct advance in each face.

; Regular
? font-metrics face=regular -> ascent=1.3158268275372604 descent=-0.30801987224982258
? text-width "A" face=regular -> 0.96948190205819729
? text-width "a" face=regular -> 0.80837473385379699
? text-width " " face=regular -> 0.40383250532292408
? text-width "☃" face=regular -> 1.0901348474095103
? text-width "Ø" face=regular -> 1.1305890702625976
? text-width "⌀" face=regular -> 1.1305890702625976
? text-width "ď" face=regular -> 0.89354151880766497
? text-width "Normale grassetto" face=regular -> 11.875088715400993
? font-metrics -> ascent=1.3158268275372604 descent=-0.30801987224982258
? text-width "Normale grassetto" -> 11.875088715400993
? text-width "ď" -> 0.89354151880766497

