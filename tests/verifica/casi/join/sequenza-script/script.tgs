; Casi a, b, c di autocad-unione.dxf per JOIN in sequenza script (!scr on, ADR 0032 punto 8)
!view 120,5 0.5 1400x400
!scr on
OPEN
ingresso.dxf
; Caso a: due linee allineate contigue
JOIN
5,0
15,0

; Caso b: due linee allineate con spazio
JOIN
35,0
50,0

; Caso c: due archi concentrici dello stesso cerchio (un clic per arco)
JOIN
88.6603,5
75,8.6603

; Sorgente polilinea con linea contigua
JOIN
225,0
235,10

