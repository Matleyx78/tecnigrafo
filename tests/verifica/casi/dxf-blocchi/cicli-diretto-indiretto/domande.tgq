; Handwritten fixture: SELF->SELF and A->B->A. Cyclic internal INSERTs
; must be retained raw, preserving handles/owners instead of recursing forever.
D = DXF file=dati.dxf
? roundtrip D -> identical
? roundtrip D as=cadx -> identical
; cambia con #697
? count D -> INSERT 2
? entity D 100 -> INSERT block="SELF" insertion=0,0 scale=1,1 rotation=0
? entity D 101 -> INSERT block="A" insertion=10,20 scale=1,1 rotation=0
