; Handwritten fixture: outer precedes child; nonzero base, units=4,
; non-explodable/uniform flags, anonymous *U/*X, empty block and XDATA.
; ADR 0018 section 6 requires the original group order and extras to survive.
D = DXF file=dati.dxf
? version D -> AC1032
? units D -> 4
? roundtrip D -> identical
? roundtrip D as=cadx -> identical
; PT18 moves INSERT from raw data into the model.
; cambia con #697
? count D -> INSERT 5
? unhandled D -> none
? entity D 100 -> INSERT block="Z_OUTER" insertion=100,50 scale=1,1 rotation=0
? entity D 101 -> INSERT block="A_CHILD" insertion=10,20 scale=-2,1 rotation=90
? entity D 102 -> INSERT block="*U7" insertion=0,0 scale=1,1 rotation=0
? entity D 103 -> INSERT block="*X8" insertion=0,0 scale=1,1 rotation=0
? entity D 104 -> INSERT block="EMPTY" insertion=0,0 scale=1,1 rotation=0
; Definition records and their contents are not drawing entities.
? entity D 40 -> none
? entity D 53 -> none
