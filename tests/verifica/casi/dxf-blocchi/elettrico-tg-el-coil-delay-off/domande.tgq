; RT18: immutable CC0 drawing, independently counted from its DXF groups.
D = DXF source=elettrico-tg-el-coil-delay-off
? roundtrip D -> identical
? roundtrip D as=cadx -> identical
; PT18 changes the interpretation of ATTDEF/INSERT and their owned ATTRIBs.
; cambia con #697
? count D -> LINE 10
? unhandled D -> ATTDEF 21; SOLID 1
; TG_PIN1=N, flags=3 (constant + invisible).
? snaps D:48 -> Insertion 0,0
; TG_PIN2=S, flags=3 (constant + invisible).
? snaps D:49 -> Insertion 0,-10
