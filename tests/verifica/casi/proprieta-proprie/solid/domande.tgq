; PT22 (#943): coordinates in DXF group order (10, 11, 12, 13).
S = SOLID vertex=0,0 vertex=10,0 vertex=0,10 vertex=10,10
? properties S -> vertex1=0,0; vertex2=10,0; vertex3=0,10; vertex4=10,10
? set-property S vertex1=-2,1 -> SOLID vertex=-2,1 vertex=10,0 vertex=0,10 vertex=10,10 | vertex1=-2,1; vertex2=10,0; vertex3=0,10; vertex4=10,10
? set-property S vertex2=20,0 -> SOLID vertex=0,0 vertex=20,0 vertex=0,10 vertex=10,10 | vertex1=0,0; vertex2=20,0; vertex3=0,10; vertex4=10,10
? set-property S vertex3=1,12 -> SOLID vertex=0,0 vertex=10,0 vertex=1,12 vertex=10,10 | vertex1=0,0; vertex2=10,0; vertex3=1,12; vertex4=10,10
? set-property S vertex4=11,12 -> SOLID vertex=0,0 vertex=10,0 vertex=0,10 vertex=11,12 | vertex1=0,0; vertex2=10,0; vertex3=0,10; vertex4=11,12
? set-property S vertex4=0,10 -> SOLID vertex=0,0 vertex=10,0 vertex=0,10 vertex=0,10 | vertex1=0,0; vertex2=10,0; vertex3=0,10; vertex4=0,10
? properties S -> vertex1=0,0; vertex2=10,0; vertex3=0,10; vertex4=10,10
; A duplicated third vertex represents a triangle and survives an edit to the first.
T = SOLID vertex=0,0 vertex=10,0 vertex=0,10 vertex=0,10
? properties T -> vertex1=0,0; vertex2=10,0; vertex3=0,10; vertex4=0,10
? set-property T vertex1=-2,1 -> SOLID vertex=-2,1 vertex=10,0 vertex=0,10 vertex=0,10 | vertex1=-2,1; vertex2=10,0; vertex3=0,10; vertex4=0,10
