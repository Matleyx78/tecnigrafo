; RT24 / PT24 (#962). Expected values follow the PT24 property contract,
; ADR 0045.2/6, ADR 0046.2 and ADR 0056.1; no Tecnigrafo executable was used.

M = MTEXT insertion=0,0 height=2.5 width=60 attachment=top-left rotation=15 style="Standard" line-spacing=1.5 line-spacing-style=exactly value="uno\\Pdue"
? properties M -> value="uno\\Pdue"; style="Standard"; attachment=top-left; width=60; height=2.5; rotation=15; line-spacing=1.5; line-spacing-style=exactly
? set-property M value="tre" -> MTEXT insertion=0,0 height=2.5 width=60 attachment=top-left rotation=15 style="Standard" line-spacing=1.5 line-spacing-style=exactly value="tre" | value="tre"; style="Standard"; attachment=top-left; width=60; height=2.5; rotation=15; line-spacing=1.5; line-spacing-style=exactly
? set-property M style="Missing" -> invalid
? set-property M attachment=bottom-right -> MTEXT insertion=0,0 height=2.5 width=60 attachment=bottom-right rotation=15 style="Standard" line-spacing=1.5 line-spacing-style=exactly value="uno\\Pdue" | value="uno\\Pdue"; style="Standard"; attachment=bottom-right; width=60; height=2.5; rotation=15; line-spacing=1.5; line-spacing-style=exactly
? set-property M attachment=left -> invalid
? set-property M width=0 -> MTEXT insertion=0,0 height=2.5 width=0 attachment=top-left rotation=15 style="Standard" line-spacing=1.5 line-spacing-style=exactly value="uno\\Pdue" | value="uno\\Pdue"; style="Standard"; attachment=top-left; width=0; height=2.5; rotation=15; line-spacing=1.5; line-spacing-style=exactly
? set-property M width=-1 -> invalid
? set-property M height=4 -> MTEXT insertion=0,0 height=4 width=60 attachment=top-left rotation=15 style="Standard" line-spacing=1.5 line-spacing-style=exactly value="uno\\Pdue" | value="uno\\Pdue"; style="Standard"; attachment=top-left; width=60; height=4; rotation=15; line-spacing=1.5; line-spacing-style=exactly
? set-property M height=0 -> invalid
? set-property M rotation=390 -> MTEXT insertion=0,0 height=2.5 width=60 attachment=top-left rotation=30 style="Standard" line-spacing=1.5 line-spacing-style=exactly value="uno\\Pdue" | value="uno\\Pdue"; style="Standard"; attachment=top-left; width=60; height=2.5; rotation=30; line-spacing=1.5; line-spacing-style=exactly
? set-property M line-spacing=2 -> MTEXT insertion=0,0 height=2.5 width=60 attachment=top-left rotation=15 style="Standard" line-spacing=2 line-spacing-style=exactly value="uno\\Pdue" | value="uno\\Pdue"; style="Standard"; attachment=top-left; width=60; height=2.5; rotation=15; line-spacing=2; line-spacing-style=exactly
? set-property M line-spacing=0 -> invalid
? set-property M line-spacing-style=at-least -> MTEXT insertion=0,0 height=2.5 width=60 attachment=top-left rotation=15 style="Standard" line-spacing=1.5 value="uno\\Pdue" | value="uno\\Pdue"; style="Standard"; attachment=top-left; width=60; height=2.5; rotation=15; line-spacing=1.5; line-spacing-style=at-least

A = ATTDEF position=0,0 height=2.5 rotation=10 style="Standard" value="D" tag="CODE" prompt="Code" invisible=yes constant=yes verify=yes preset=yes
? properties A -> tag="CODE"; prompt="Code"; default="D"; invisible=yes; constant=yes; verify=yes; preset=yes; lock-position=no; height=2.5; rotation=10; style="Standard"
? set-property A tag="NEW_CODE" -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=10 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="D" tag="NEW_CODE" prompt="Code" invisible=yes constant=yes verify=yes preset=yes | tag="NEW_CODE"; prompt="Code"; default="D"; invisible=yes; constant=yes; verify=yes; preset=yes; lock-position=no; height=2.5; rotation=10; style="Standard"
? set-property A tag="CODE 2" -> invalid
? set-property A prompt="Identifier" -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=10 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="D" tag="CODE" prompt="Identifier" invisible=yes constant=yes verify=yes preset=yes | tag="CODE"; prompt="Identifier"; default="D"; invisible=yes; constant=yes; verify=yes; preset=yes; lock-position=no; height=2.5; rotation=10; style="Standard"
? set-property A default="X" -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=10 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="X" tag="CODE" prompt="Code" invisible=yes constant=yes verify=yes preset=yes | tag="CODE"; prompt="Code"; default="X"; invisible=yes; constant=yes; verify=yes; preset=yes; lock-position=no; height=2.5; rotation=10; style="Standard"
? set-property A invisible=no -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=10 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="D" tag="CODE" prompt="Code" constant=yes verify=yes preset=yes | tag="CODE"; prompt="Code"; default="D"; invisible=no; constant=yes; verify=yes; preset=yes; lock-position=no; height=2.5; rotation=10; style="Standard"
? set-property A constant=no -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=10 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="D" tag="CODE" prompt="Code" invisible=yes verify=yes preset=yes | tag="CODE"; prompt="Code"; default="D"; invisible=yes; constant=no; verify=yes; preset=yes; lock-position=no; height=2.5; rotation=10; style="Standard"
? set-property A verify=no -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=10 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="D" tag="CODE" prompt="Code" invisible=yes constant=yes preset=yes | tag="CODE"; prompt="Code"; default="D"; invisible=yes; constant=yes; verify=no; preset=yes; lock-position=no; height=2.5; rotation=10; style="Standard"
? set-property A preset=no -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=10 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="D" tag="CODE" prompt="Code" invisible=yes constant=yes verify=yes lock-position=yes | tag="CODE"; prompt="Code"; default="D"; invisible=yes; constant=yes; verify=yes; preset=no; lock-position=no; height=2.5; rotation=10; style="Standard"
? set-property A lock-position=yes -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=10 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="D" tag="CODE" prompt="Code" invisible=yes constant=yes verify=yes preset=yes lock-position=yes | tag="CODE"; prompt="Code"; default="D"; invisible=yes; constant=yes; verify=yes; preset=yes; lock-position=yes; height=2.5; rotation=10; style="Standard"
? set-property A height=0 -> invalid
? set-property A rotation=-30 -> ATTDEF position=0,0 alignment-point=0,0 height=2.5 rotation=330 width-factor=1 oblique=0 style="Standard" mirror-x=no mirror-y=no horizontal=left vertical=baseline value="D" tag="CODE" prompt="Code" invisible=yes constant=yes verify=yes preset=yes | tag="CODE"; prompt="Code"; default="D"; invisible=yes; constant=yes; verify=yes; preset=yes; lock-position=no; height=2.5; rotation=330; style="Standard"
? set-property A style="Missing" -> invalid

!block "B1" base=0,0
L1 = LINE start=0,0 end=10,0
!endblock
!block "B2" base=0,0
C2 = CIRCLE center=0,0 radius=5
!endblock
I = INSERT block="B1" insertion=10,20 scale=2,-3 rotation=25
? properties I -> block="B1"; insertion=10,20; scale=2,-3; scale-z=1; rotation=25
? set-property I block="B2" -> INSERT block="B2" insertion=10,20 scale=2,-3 rotation=25 | block="B2"; insertion=10,20; scale=2,-3; scale-z=1; rotation=25
? set-property I block="MISSING" -> invalid
? set-property I insertion=-4,8 -> INSERT block="B1" insertion=-4,8 scale=2,-3 rotation=25 | block="B1"; insertion=-4,8; scale=2,-3; scale-z=1; rotation=25
? set-property I scale=-1,4 -> INSERT block="B1" insertion=10,20 scale=-1,4 rotation=25 | block="B1"; insertion=10,20; scale=-1,4; scale-z=1; rotation=25
? set-property I scale=0,1 -> invalid
? set-property I scale-z=-2 -> INSERT block="B1" insertion=10,20 scale=2,-3 rotation=25 | block="B1"; insertion=10,20; scale=2,-3; scale-z=-2; rotation=25
? set-property I scale-z=0 -> invalid
? set-property I rotation=400 -> INSERT block="B1" insertion=10,20 scale=2,-3 rotation=40 | block="B1"; insertion=10,20; scale=2,-3; scale-z=1; rotation=40
!block "Loop" base=0,0
Nested = INSERT block="B1" insertion=0,0
!endblock
? set-property Nested block="Loop" -> invalid
