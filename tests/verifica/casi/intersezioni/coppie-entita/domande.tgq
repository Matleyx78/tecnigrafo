; Intersezioni: coppie tra linea, arco, cerchio e polilinea con archi
; [0.7-R14] #356, lavoro [0.7-P14] #357: domanda `intersections`
; (docs/verifica/domande.md, "Intersezioni, lato e tolleranze"; ADR 0035, punti 1 e 6).
; Valori attesi geometrici conformi alle definizioni di solid-space (tests/corpus/casi/geom2d/,
; commit 336b4286ed721ae71eefcfaafe7527f4c4beeb3b).

; --- Linea contro Linea ---
L1 = LINE start=0,0 end=10,0
L2 = LINE start=5,-5 end=5,5
? intersections L1 L2 -> 5,0 crossing 0:inside 0:inside

; linee parallele
L_PAR = LINE start=0,2 end=10,2
? intersections L1 L_PAR -> none

; incontro all'estremo
L_CORNER = LINE start=10,0 end=10,10
? intersections L1 L_CORNER -> 10,0 crossing 0:end 0:start

; sovrapposizione parziale sulla stessa retta
L_OVER = LINE start=5,0 end=15,0
? intersections L1 L_OVER -> overlap 5,0 10,0

; linea che non incontra ma incontra se prolungata
L_SHORT = LINE start=0,0 end=5,0
L_TARGET = LINE start=10,-5 end=10,5
? intersections L_SHORT L_TARGET -> none
? intersections L_SHORT L_TARGET extend=a -> 10,0 crossing 0:after 0:inside

; --- Linea contro Cerchio ---
C1 = CIRCLE center=5,0 radius=3
? intersections L1 C1 -> 2,0 crossing 0:inside 0:inside; 8,0 crossing 0:inside 0:inside

; linea tangente al cerchio in cima
L_TAN = LINE start=0,3 end=10,3
? intersections L_TAN C1 -> 5,3 touching 0:inside 0:inside

; linea esterna al cerchio
L_OUT = LINE start=0,4 end=10,4
? intersections L_OUT C1 -> none

; --- Linea contro Arco ---
; arco sopra l'asse x da 0 a 180 gradi
A1 = ARC center=5,0 radius=3 start-angle=0 end-angle=180
; la linea incontra l'arco al suo inizio (angolo 0, punto 8,0) e alla sua fine (angolo 180, punto 2,0)
? intersections L1 A1 -> 2,0 crossing 0:inside 0:end; 8,0 crossing 0:inside 0:start

; arco che non tocca la linea ma la tocca se prolungato al cerchio intero (extend=b)
A_HIGH = ARC center=5,0 radius=3 start-angle=30 end-angle=150
? intersections L1 A_HIGH -> none
? intersections L1 A_HIGH extend=b -> 2,0 crossing 0:inside 0:before; 8,0 crossing 0:inside 0:after

; arco con end-angle minore di start-angle (attraversa lo 0)
A_CROSS0 = ARC center=0,0 radius=5 start-angle=300 end-angle=60
L_AXIS = LINE start=-10,0 end=10,0
? intersections L_AXIS A_CROSS0 -> 5,0 crossing 0:inside 0:inside

; --- Cerchio contro Cerchio ---
; due cerchi secanti
C_LEFT = CIRCLE center=0,0 radius=5
C_RIGHT = CIRCLE center=6,0 radius=5
? intersections C_LEFT C_RIGHT -> 3,4 crossing 0:inside 0:inside; 3,-4 crossing 0:inside 0:inside

; due cerchi tangenti esterni
C_T1 = CIRCLE center=0,0 radius=3
C_T2 = CIRCLE center=5,0 radius=2
? intersections C_T1 C_T2 -> 3,0 touching 0:inside 0:inside

; due cerchi tangenti interni
C_TI1 = CIRCLE center=0,0 radius=5
C_TI2 = CIRCLE center=2,0 radius=3
? intersections C_TI1 C_TI2 -> 5,0 touching 0:inside 0:inside

; due cerchi separati
C_FAR = CIRCLE center=20,0 radius=2
? intersections C_T1 C_FAR -> none

; due cerchi concentrici
C_CONC = CIRCLE center=0,0 radius=10
? intersections C_LEFT C_CONC -> none

; --- Arco contro Arco ---
; archi secanti
A_SEC1 = ARC center=0,0 radius=5 start-angle=0 end-angle=90
A_SEC2 = ARC center=5,5 radius=5 start-angle=180 end-angle=270
? intersections A_SEC1 A_SEC2 -> 0,5 crossing 0:end 0:start; 5,0 crossing 0:start 0:end

; archi dello stesso cerchio con sovrapposizione parziale
A_OV1 = ARC center=0,0 radius=5 start-angle=0 end-angle=120
A_OV2 = ARC center=0,0 radius=5 start-angle=60 end-angle=180
? intersections A_OV1 A_OV2 -> overlap 2.5,4.330127018922194 -2.5,4.330127018922193

; --- Linea contro Polilinea (con arco) ---
; polilinea a due segmenti: segmento 0 dritto (0,0)-(10,0), segmento 1 curvo (bulge=1 semicirconferenza) fino a (20,0)
P1 = LWPOLYLINE vertex=0,0 vertex=10,0 bulge=1 vertex=20,0
; linea verticale che incontra il segmento dritto
L_VERTD = LINE start=5,-5 end=5,5
? intersections L_VERTD P1 -> 5,0 crossing 0:inside 0:inside

; linea verticale che incontra il segmento curvo (al vertice alto dell'arco, punto 15,5)
L_VERTC = LINE start=15,-5 end=15,10
? intersections L_VERTC P1 -> 15,5 touching 0:inside 1:inside

; linea verticale che attraversa esattamente il vertice comune tra i due segmenti
L_VERT_VTX = LINE start=10,-5 end=10,5
? intersections L_VERT_VTX P1 -> 10,0 crossing 0:inside 1:start
