; Domande su Aligned e Fit (ADR 0022, punto 3; [0.5-R2], lavoro #155)
; Misure di LiberationSans-Regular.ttf 2.1.5 lette con fontTools (cmap, hmtx):
;   a = 1854/1409 = 1.3158268275372604, d = -434/1409 = -0.3080198722498226
;   L("Hello") = 6783/2048 * 2048/1409 = 3.312278211497516
; La rotazione e la direzione da P1 = position a P2 = alignment-point; il gruppo 50
; si conserva e non si usa. Aligned: h = |P2 - P1| / (L f); Fit: f = |P2 - P1| / (L h).
; A = P1, (ox, oy) = (0, 0); 73 non conta; snap d'inserimento in P1.

; Aligned orizzontale, f = 0.8 conservato, rotazione 45 ignorata: A = 0,0, (ox, oy) = (0, 0), h = 4.528605099635739, f = 0.8, w = 11.999999999999998, rotazione = 0 gradi
AL_X = TEXT position=0,0 alignment-point=12,0 rotation=45 width-factor=0.8 horizontal=aligned value="Hello"
? box AL_X -> 0,-1.3949003642596955 11.999999999999998,-1.3949003642596955 11.999999999999998,5.958860081422754 0,5.958860081422754
? bbox AL_X -> 0,-1.3949003642596955 11.999999999999998,5.958860081422754
? snaps AL_X -> Insertion 0,0

; Aligned da 1,2 a 4,6 (lunghezza 5, direzione atan2(4, 3)): A = 1,2, (ox, oy) = (0, 0), h = 1.5095350332119135, f = 1, w = 5, rotazione = 53.130102354 gradi
AL_345 = TEXT position=1,2 alignment-point=4,6 horizontal=aligned value="Hello"
? box AL_345 -> 1.3719734304692521,1.7210199271480608 4.371973430469252,5.721019927148061 2.410970644953932,7.191772016284551 -0.5890293550460679,3.1917720162845513
? bbox AL_345 -> -0.5890293550460679,1.7210199271480608 4.371973430469252,7.191772016284551
? snaps AL_345 -> Insertion 1,2

; Aligned come AL_345 con 73 = top, che non conta: A = 1,2, (ox, oy) = (0, 0), h = 1.5095350332119135, f = 1, w = 5, rotazione = 53.130102354 gradi
AL_TOP = TEXT position=1,2 alignment-point=4,6 horizontal=aligned vertical=top value="Hello"
? box AL_TOP -> 1.3719734304692521,1.7210199271480608 4.371973430469252,5.721019927148061 2.410970644953932,7.191772016284551 -0.5890293550460679,3.1917720162845513
? bbox AL_TOP -> -0.5890293550460679,1.7210199271480608 4.371973430469252,7.191772016284551
? snaps AL_TOP -> Insertion 1,2

; Aligned da destra a sinistra: rotazione 180: A = 20,5, (ox, oy) = (0, 0), h = 3.622884079708592, f = 1, w = 12, rotazione = 180 gradi
AL_BACK = TEXT position=20,5 alignment-point=8,5 horizontal=aligned value="Hello"
? box AL_BACK -> 20,6.115920291407757 8,6.115920291407758 7.999999999999999,0.2329119348617974 20,0.23291193486179562
? bbox AL_BACK -> 7.999999999999999,0.23291193486179562 20,6.115920291407758
? snaps AL_BACK -> Insertion 20,5

; Fit orizzontale, h = 2.5 conservata, f = 0.8 e rotazione 45 ignorate: A = 0,0, (ox, oy) = (0, 0), h = 2.5, f = 1.4491536318834368, w = 12, rotazione = 0 gradi
FT_X = TEXT position=0,0 alignment-point=12,0 rotation=45 width-factor=0.8 horizontal=fit value="Hello"
? box FT_X -> 0,-0.7700496806245565 12,-0.7700496806245565 12,3.289567068843151 0,3.289567068843151
? bbox FT_X -> 0,-0.7700496806245565 12,3.289567068843151
? snaps FT_X -> Insertion 0,0

