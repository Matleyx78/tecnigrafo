; Domande sui 15 allineamenti del testo (ADR 0022, punti 1, 2 e 5; [0.5-R2], lavoro #155)
; Misure di LiberationSans-Regular.ttf 2.1.5 lette con fontTools (cmap, hmtx):
;   a = 1854/1409 = 1.3158268275372604, d = -434/1409 = -0.3080198722498226
;   L("Hello") = 6783/2048 * 2048/1409 = 3.312278211497516
; Testo "Hello", h = 2.5, f = 1, rotazione 0: w = L * h = 8.28069552874379
; Il punto (x, y) del rettangolo va in A + (x - ox, y - oy).
; A = position solo con 72 = 0 e 73 = 0; altrimenti A = alignment-point (10,20).
; Lo snap d'inserimento e in A.

; 72 left, 73 baseline: A = 3,4, (ox, oy) = (0, 0), h = 2.5, f = 1, w = 8.28069552874379, rotazione = 0 gradi
L_BASE = TEXT position=3,4 alignment-point=10,20 value="Hello"
? box L_BASE -> 3,3.2299503193754435 11.28069552874379,3.2299503193754435 11.28069552874379,7.2895670688431515 3,7.2895670688431515
? bbox L_BASE -> 3,3.2299503193754435 11.28069552874379,7.2895670688431515
? snaps L_BASE -> Insertion 3,4

; 72 left, 73 bottom: A = 10,20, (ox, oy) = (0, -0.7700496806245565), h = 2.5, f = 1, w = 8.28069552874379, rotazione = 0 gradi
L_B = TEXT position=3,4 alignment-point=10,20 vertical=bottom value="Hello"
? box L_B -> 10,20 18.28069552874379,20 18.28069552874379,24.059616749467708 10,24.059616749467708
? bbox L_B -> 10,20 18.28069552874379,24.059616749467708
? snaps L_B -> Insertion 10,20

