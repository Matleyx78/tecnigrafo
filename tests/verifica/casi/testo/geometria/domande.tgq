? bbox T_rot180 -> 21.5195173882186,36.05251951738822 30,40.92405961674947
? bbox T_rot270 -> -10.61603974449965,-27.75471965933286 -7.368346344925479,-20
? bbox T_rot45 -> 6.278279709524886,19.12878823836775 14.29884789754717,27.14935642639003
? bbox T_c -> 0,-0.7700496806245565 6.868346344925479,3.289567068843151
