; Domande al modello sulla geometria del testo (ADR 0013, P13)
; Misure ricavate dal font Liberation Sans 2.1.5 con fontTools

; 1. Testo base (Hello, h=2.5, rot=0, wf=1) all'origine
T1 = TEXT position=0,0 height=2.5 rotation=0 width-factor=1 value="Hello"

; 2. Altezza scalata (h=5.0) e posizione traslata
T_h5 = TEXT position=10,20 height=5.0 rotation=0 width-factor=1 value="Hello"

; 3. Fattore di larghezza diverso da 1 (wf=0.8)
T_wf = TEXT position=0,0 height=2.5 rotation=0 width-factor=0.8 value="Hello"

; 4. Rotazioni nei quattro quadranti e a 45 gradi
T_rot90 = TEXT position=0,0 height=2.5 rotation=90 width-factor=1 value="Hello"
T_rot180 = TEXT position=30,40 height=3.0 rotation=180 width-factor=1 value="Test"
T_rot270 = TEXT position=-10,-20 height=2.0 rotation=270 width-factor=0.8 value="Vertical"
T_rot45 = TEXT position=10,20 height=4.0 rotation=45 width-factor=1.25 value="A"

; 5. Codici di controllo DXF: %%c (diametro), %%d (gradi), %%p (piu-meno), %%% (percento)
T_c = TEXT position=0,0 height=2.5 rotation=0 width-factor=1 value="%%c20"
T_d = TEXT position=0,0 height=2.5 rotation=0 width-factor=1 value="45%%d"
T_p = TEXT position=0,0 height=2.5 rotation=0 width-factor=1 value="%%p0.1"
T_pct = TEXT position=0,0 height=2.5 rotation=0 width-factor=1 value="100%%%"

; 6. Codici di controllo incompleti (%% finale e %%x non riconosciuto)
T_inc1 = TEXT position=0,0 height=2.5 rotation=0 width-factor=1 value="10%%"
T_inc2 = TEXT position=0,0 height=2.5 rotation=0 width-factor=1 value="%%x"

; 7. Casi limite: stringa vuota e soli spazi
T_empty = TEXT position=5,5 height=2.0 rotation=0 width-factor=1 value=""
T_spaces = TEXT position=0,0 height=2.5 rotation=0 width-factor=1 value="   "

; --- Rettangolo dingombro (box) ---
