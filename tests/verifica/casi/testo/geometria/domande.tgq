? box T_rot90 -> 0.7700496806245565,0 0.770049680624557,8.28069552874379 -3.289567068843151,8.28069552874379 -3.289567068843151,0
? box T_rot180 -> 30,40.92405961674947 21.5195173882186,40.92405961674947 21.5195173882186,36.05251951738822 30,36.05251951738822
