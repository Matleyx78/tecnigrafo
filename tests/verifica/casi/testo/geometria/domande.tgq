; --- Lunghezza: il testo e una regione, non una curva (length none) ---
? length T1 -> none
? length T_rot90 -> none
? length T_empty -> none

; --- Distanza e punto piu vicino (distance, closest) ---
; Punti allinterno del rettangolo dingombro hanno distanza zero e punto stesso
? distance T1 0,0 -> 0
? closest T1 0,0 -> 0,0
? distance T1 4,1 -> 0
? closest T1 4,1 -> 4,1
? distance T1 0,-0.7700496806245565 -> 0
? closest T1 0,-0.7700496806245565 -> 0,-0.7700496806245565
; Punti allesterno di T1: distanza perpendicolare ai bordi
; Bordo sinistro x=0: punto (-3, 1)
? distance T1 -3,1 -> 3
? closest T1 -3,1 -> 0,1
; Bordo superiore y=3.289567068843151: punto (4, 5.289567068843151)
? distance T1 4,5.289567068843151 -> 2
? closest T1 4,5.289567068843151 -> 4,3.289567068843151
; Testo ruotato a 90 gradi: punto allinterno
? distance T_rot90 -1,4 -> 0
? closest T_rot90 -1,4 -> -1,4
; Testo ruotato a 90 gradi: punto esterno al bordo x=0.770049680624557
? distance T_rot90 2.770049680624557,4 -> 2
? closest T_rot90 2.770049680624557,4 -> 0.770049680624557,4

; --- Selezione a finestra e a intersezione (inside, crosses) ---
; Finestra che racchiude interamente T1
? inside T1 -1,-2 10,5 -> yes
? crosses T1 -1,-2 10,5 -> yes
; Rettangolo tutto contenuto allinterno del rettangolo dingombro di T1
? inside T1 2,0 6,2 -> no
? crosses T1 2,0 6,2 -> yes
; Rettangolo che interseca parzialmente il bordo di T1
? inside T1 5,2 10,5 -> no
? crosses T1 5,2 10,5 -> yes
; Rettangolo completamente disgiunto da T1
? inside T1 20,20 30,30 -> no
? crosses T1 20,20 30,30 -> no

; --- Punti di snap su singola entita (snaps) ---
; T1 ha lo snap Insertion nel punto di inserimento position (0,0)
? snaps T1 -> Insertion 0,0
? snaps T1 modes=insertion -> Insertion 0,0
? snaps T1 modes=endpoint,midpoint -> none
? snaps T1 modes=none -> none
? snaps T_h5 -> Insertion 10,20
? snaps T_rot180 -> Insertion 30,40
? snaps T_empty -> Insertion 5,5
