; --- Riquadro assi-allineato (bbox) ---
? bbox T1 -> 0,-0.7700496806245565 8.28069552874379,3.289567068843151
? bbox T_h5 -> 10,18.45990063875089 26.56139105748758,26.5791341376863
? bbox T_wf -> 0,-0.7700496806245565 6.624556422995032,3.289567068843151
