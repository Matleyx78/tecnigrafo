; The target already owns Shared: its record wins, while New and Child enter.
L = LAYER name="Shared" color=1
I = BLOCK-IMPORT file=tabelle.dxf
? import-error I -> none
? import-definition I -> name="tabelle" base=0,0 units=0 entities=[107 INSERT block="Child" insertion=5,6 scale=1,1 rotation=0]
? import-nested I -> name="Child" base=0,0 units=0 entities=[105 LINE start=0,0 end=2,0]
? import-layers I -> id=102 name="New" color=3 linetype="Continuous" lineweight=default
? import-next-id I -> 108
? import-groups I 105 -> 5="105" 330="103" 340="102" 360="103" 102="{ACAD_REACTORS" 330="104" 102="}"
