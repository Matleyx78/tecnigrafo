; FILLET e CIRCLE Ttr nella sequenza degli script (!scr on, ADR 0032 punto 8)
!view 270,100 0.25 2400x1200
!scr on
OPEN
ingresso.dxf
; Impostazione raggio: il comando termina subito dopo il valore
FILLET
R
10
; Esecuzione raccordo raggio 10
FILLET
20,0
0,20
; Raccordo polilinea raggio 10
FILLET
P
370,0
; Impostazione trim No: il comando termina subito dopo l'opzione
FILLET
T
N
; Impostazione raggio 5
FILLET
R
5
; Esecuzione raccordo No trim
FILLET
520,0
500,20
; CIRCLE Ttr in sequenza script
CIRCLE
T
10,200
0,210
8
