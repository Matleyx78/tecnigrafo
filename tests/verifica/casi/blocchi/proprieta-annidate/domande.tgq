; ADR 0045.3: layer 0 inherits the insertion layer at both levels.
; ByBlock follows the insertion's explicit values; ByLayer follows the display layer.
? window -1,-1 1,1 -> none
Dash = LTYPE name="Dash" pattern=3,-1 description="Reference dashes"
Red = LAYER name="Red" color=1 linetype="Dash" lineweight=0.5
Blue = LAYER name="Blue" color=5 lineweight=0.35 locked
Off = LAYER name="Off" color=2 off
Frozen = LAYER name="Frozen" color=4 frozen
; PT9 section 4 rejects !block today; PT16 deliberately makes it valid.
; cambia con #693
!block "Leaf" base=0,0
ByBlock = LINE start=0,0 end=10,0 color=byblock linetype="ByBlock" lineweight=byblock
ByLayer = LINE start=0,2 end=10,2
OwnLayer = LINE start=0,4 end=10,4 layer="Blue"
HiddenOff = LINE start=0,6 end=10,6 layer="Off"
HiddenFrozen = LINE start=0,8 end=10,8 layer="Frozen"
!endblock
!block "Middle" base=0,0
Child = INSERT block="Leaf" insertion=0,0 color=byblock linetype="ByBlock" lineweight=byblock
!endblock
Visible = INSERT block="Middle" insertion=100,50 layer="Red" color=3 linetype="Dash" lineweight=0.7
? generated Visible -> LINE start=100,50 end=110,50 color=0,255,0 linetype="Dash" lineweight=0.7; LINE start=100,52 end=110,52 color=255,0,0 linetype="Dash" lineweight=0.5; LINE start=100,54 end=110,54 color=0,0,255 lineweight=0.35 locked=yes
; The hidden children's geometry must not affect visible window selection.
? window 99,49 111,55 -> Visible
OffInsert = INSERT block="Middle" insertion=200,50 layer="Off"
FrozenInsert = INSERT block="Middle" insertion=300,50 layer="Frozen"
? generated OffInsert -> none
? generated FrozenInsert -> none
? pick 205,50 tolerance=1 -> none
? pick 305,50 tolerance=1 -> none
? window 199,49 211,59 -> none
? window 299,49 311,59 -> none
? snap 200,50 aperture=1 modes=insertion -> none
? snap 300,50 aperture=1 modes=insertion -> none
