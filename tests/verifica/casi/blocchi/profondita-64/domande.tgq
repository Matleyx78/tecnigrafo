; PT16 P17: the outer INSERT counts as level 1; the maximum is 64.
; B1 contains a line; each Bn adds one insertion and a translation (1,0).
; Hence B63/B64 reach the line at x=63/64, but B65 must stop before B1.
? window -1,-1 1,1 -> none
; PT9 section 4 rejects !block today; PT16 deliberately makes it valid.
; cambia con #693
!block "B1" base=0,0
Leaf = LINE start=1,1 end=2,1
!endblock
!block "B2" base=0,0
Child2 = INSERT block="B1" insertion=1,0
!endblock
!block "B3" base=0,0
Child3 = INSERT block="B2" insertion=1,0
!endblock
