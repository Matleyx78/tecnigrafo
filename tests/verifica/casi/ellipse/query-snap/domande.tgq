; RT50 / PT50 (#744). Expectations never obtained by running Tecnigrafo.
; solid-space tests/corpus/casi/geom2d/ellipse-delicate-mm-retta-secante.json
; at fc8cae3da8a737510d6b61075b03ea3272228576, full carrier with start 0.
E = ELLIPSE center=0,0 major-axis=10,0 ratio=0.5
L = LINE start=-20,0 end=20,0
; cambia con #744
? snap 10.1,0.1 aperture=0.5 modes=intersection -> Intersection 10,0
? snap -10.1,0.1 aperture=0.5 modes=intersection -> Intersection -10,0
? snap 10.1,0.1 aperture=0.05 modes=intersection -> none
? snap 10.1,0.1 aperture=0.5 modes=none -> none
? snaps E modes=endpoint -> none
? snap 10.1,0.1 aperture=0.5 modes=endpoint -> none
? snap 10.1,0.1 aperture=0.5 modes=quadrant -> Quadrant 10,0
; Intersection wins an exact tie with Quadrant (ADR 0033).
? snap 10.1,0.1 aperture=0.5 modes=intersection,quadrant -> Intersection 10,0
; An ordinary endpoint wins a tie with Intersection.
End = LINE start=10,0 end=12,2
? snap 10.1,0.1 aperture=0.5 modes=endpoint,intersection,quadrant -> Endpoint 10,0
; No extension in findSnap: the full ellipse intersects at (-10,0), this arc does not.
Arc = ELLIPSE center=50,0 major-axis=10,0 ratio=0.5 start=-45 end=0
Axis = LINE start=30,0 end=70,0
? snap 40.1,0.1 aperture=0.5 modes=intersection -> none
? snap 60.1,0.1 aperture=0.5 modes=intersection -> Intersection 60,0
? snap 60.1,0.1 aperture=0.5 modes=endpoint,intersection -> Endpoint 60,0
