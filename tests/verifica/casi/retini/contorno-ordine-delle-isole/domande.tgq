; RT43 / PT43 (#740). No Tecnigrafo executable supplied expected values.
; Facade and flags: docs/tappe/0.8/PT43-contorni-dei-retini.md, points 2-5.
; Geometry: Matleyx78/solid-space at d84a40a6255da5fd01ca2918fc645aa77b8d5131.
; tests/corpus/casi/geom2d/contorni-richiesta-annidati.json
; The disjoint nested loops keep the corpus depths 0,1,1,2.
; boundary.hpp orders by depth, then exact lexicographic vertex sequence.
; A circle contributes center-(radius,0) to that ordering.

Bottom = LINE start=0,0 end=20,0
Right = LINE start=20,0 end=20,10
Top = LINE start=20,10 end=0,10
Left = LINE start=0,10 end=0,0
; Reverse the two circle definitions and define the deepest island first.
Triangle = LWPOLYLINE closed=yes vertex=14,4 vertex=16,4 vertex=15,6
RightCircle = CIRCLE center=15,5 radius=3
LeftCircle = CIRCLE center=5,5 radius=3
? hatch-boundary 1,1 -> enclosed loop=external+derived+polyline vertex=0,0 vertex=20,0 vertex=20,10 vertex=0,10 loop=outermost+derived+edges circle=5,5;3 loop=outermost+derived+edges circle=15,5;3 loop=derived+polyline vertex=14,4 vertex=16,4 vertex=15,6
